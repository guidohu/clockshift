    <string name="welcome_point_1_text">One tap when you start, one when you finish. Add breaks as you go.</string>
    <string name="welcome_point_2_title">Standard days</string>
    <string name="welcome_point_2_text">Forget to log? Your usual hours are assumed, so nothing piles up.</string>
    <string name="welcome_point_3_title">Overtime that adds up</string>
    <string name="welcome_point_3_text">Work more and it builds up. Work less and it is deducted.</string>
